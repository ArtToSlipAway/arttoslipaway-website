# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=arttoslipaway
DB_USER=arttoslipaway
DB_PASSWORD=replace-with-a-strong-password

# Admin access
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_COOKIE_SECURE=false
ADMIN_CSRF_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
STATS_IP_HASH_SECRET=replace-with-an-independent-random-secret

# Public URL
SITE_BASE_URL=http://127.0.0.1:8000
DEMO_MODE=true

# Optional read-only Google Calendar integration
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials/google-calendar.json
GOOGLE_CALENDAR_WORK_ID=
GOOGLE_CALENDAR_TATTOO_ID=

# Optional email notifications
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ArtToSlipAway
SMTP_ADMIN_TO=
